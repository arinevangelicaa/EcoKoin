<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcoKoin</RootNamespace>
    <AssemblyName>EcoKoin.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\schema.sql" LogicalName="EcoKoin.Database.schema.sql" />
    <EmbeddedResource Include="Database\seed.sql" LogicalName="EcoKoin.Database.seed.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EcoKoin.Core.Tests" />
  </ItemGroup>

</Project>
