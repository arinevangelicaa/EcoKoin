<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcoKoin</RootNamespace>
    <AssemblyName>EcoKoin.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Database\schema.sql" Link="Database\schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Database\seed.sql" Link="Database\seed.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EcoKoin.Core.Tests" />
  </ItemGroup>

</Project>
