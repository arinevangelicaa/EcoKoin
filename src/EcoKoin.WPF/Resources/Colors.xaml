<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- EcoKoin Figma color tokens -->
    <Color x:Key="ForestGreenColor">#2C4C3E</Color>
    <Color x:Key="OceanCyanColor">#B4D4D1</Color>
    <Color x:Key="MistyColor">#E9F2F1</Color>
    <Color x:Key="BlackberryColor">#222826</Color>
    <Color x:Key="SunOrangeColor">#D97746</Color>

    <!-- Dashboard background -->
    <Color x:Key="CanvasColor">#F6F8F7</Color>

    <!-- Reusable brushes -->
    <SolidColorBrush x:Key="ForestGreenBrush"
                     Color="{StaticResource ForestGreenColor}"/>
    <SolidColorBrush x:Key="OceanCyanBrush"
                     Color="{StaticResource OceanCyanColor}"/>
    <SolidColorBrush x:Key="MistyBrush"
                     Color="{StaticResource MistyColor}"/>
    <SolidColorBrush x:Key="BlackberryBrush"
                     Color="{StaticResource BlackberryColor}"/>
    <SolidColorBrush x:Key="SunOrangeBrush"
                     Color="{StaticResource SunOrangeColor}"/>
    <SolidColorBrush x:Key="CanvasBrush"
                     Color="{StaticResource CanvasColor}"/>

    <!-- Transparent color variants -->
    <SolidColorBrush x:Key="Forest70Brush"
                     Color="#B32C4C3E"/>
    <SolidColorBrush x:Key="Forest20Brush"
                     Color="#332C4C3E"/>
    <SolidColorBrush x:Key="Misty70Brush"
                     Color="#B3E9F2F1"/>

</ResourceDictionary>