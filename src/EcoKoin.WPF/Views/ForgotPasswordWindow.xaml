<Window x:Class="EcoKoin.WPF.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoKoin - Lupa Kata Sandi"
        Width="1200" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8F7" FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="AuthForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="AuthMuted" Color="#668177"/>
        <SolidColorBrush x:Key="AuthOutline" Color="#D5E0DB"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Tampilkan kata sandi"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E9F2F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#B4D4D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubmitButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C4C3E"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#416957"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#1E352B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D97746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*" MinWidth="340"/>
            <ColumnDefinition Width="61*" MinWidth="520"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT BRAND PANEL: existing EcoKoin image assets; no duplicate assets needed. -->
        <Border Grid.Column="0" Background="{StaticResource AuthForest}" ClipToBounds="True">
            <Grid Margin="40,30,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/Assets/Images/logo.png" Width="49" Height="46" Stretch="Uniform" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EcoKoin" Foreground="White" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Small Steps, Big Impact" Foreground="#E9F2F1" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Tenang, kita bantu&#x0a;kamu kembali."
                               FontFamily="{StaticResource HeadingFont}" FontSize="29" FontWeight="SemiBold"
                               LineHeight="37" Foreground="White"/>
                    <TextBlock Text="Pulihkan akses akunmu agar bisa melanjutkan langkah baik bersama EcoPet."
                               TextWrapping="Wrap" Margin="0,12,0,16" Foreground="#E9F2F1" FontSize="14" LineHeight="21"/>
                    <Grid Height="242" MaxWidth="330" HorizontalAlignment="Stretch">
                        <Ellipse Fill="#395C4E" Margin="0,8,0,8"/>
                        <Image Source="/Assets/Images/happy.png" Width="204" Height="232"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Teman kecil untuk kebiasaan baikmu."
                               HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13" Foreground="#E9F2F1"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="❧  Hemat energi, mulai dari PC sendiri."
                           FontSize="12" Foreground="#E9F2F1"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,12" ClipToBounds="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <Border Width="56" Height="56" Background="#E9F2F1" CornerRadius="16" HorizontalAlignment="Left">
                    <TextBlock Text="{StaticResource IconMail}" Style="{StaticResource EcoIcon}" FontSize="25"
                               Foreground="{StaticResource AuthForest}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="PEMULIHAN AKUN" FontSize="11" Foreground="{StaticResource AuthMuted}" Margin="0,22,0,6"/>
                <TextBlock Text="Lupa kata sandi?" FontFamily="{StaticResource HeadingFont}" FontSize="30"
                           FontWeight="SemiBold" Foreground="{StaticResource AuthForest}"/>
                <TextBlock Text="Masukkan email yang terdaftar. Kami akan mengirimkan tautan untuk mengatur ulang kata sandimu."
                           FontSize="14" Foreground="{StaticResource AuthMuted}" TextWrapping="Wrap" Margin="0,12,0,22"/>
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                <Border Height="52" Background="White" BorderBrush="{StaticResource AuthOutline}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <TextBox x:Name="EmailInput" Background="Transparent" BorderThickness="0" FontSize="14"
                                 Padding="14,0" Foreground="{StaticResource AuthForest}" VerticalContentAlignment="Center"
                                 TextChanged="EmailInput_TextChanged" MaxLength="254"
                                 AutomationProperties.Name="Alamat email untuk pemulihan akun"/>
                        <TextBlock x:Name="EmailPlaceholder" Text="nama@contoh.com" Margin="15,0,0,0"
                                   Foreground="{StaticResource AuthMuted}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" FontSize="14"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" FontSize="12" Foreground="#B54738"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
                <Button Content="Kirim tautan reset   ➜" Style="{StaticResource SubmitButtonStyle}"
                        Margin="0,18,0,0" Click="SendReset_Click" IsDefault="True"
                        ToolTip="Validasi email (pengiriman email sungguhan belum tersedia)"/>
                <TextBlock Text="Buka tautan dari email untuk membuat kata sandi baru."
                           FontSize="13" Foreground="{StaticResource AuthMuted}" Margin="0,16,0,16"/>
                <Button Content="←  Kembali ke Masuk" Click="BackToLogin_Click"
                        HorizontalAlignment="Center" Style="{StaticResource LinkButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>