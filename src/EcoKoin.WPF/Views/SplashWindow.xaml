<Window x:Class="EcoKoin.WPF.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoKoin"
        Width="1200"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource MistyBrush}"
        FontFamily="{StaticResource BodyFont}">

    <!-- Native Windows title bar is used instead of drawing a second title bar. -->
    <Grid Background="{StaticResource MistyBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="104"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Centered brand identity. Works at desktop sizes without scrolling. -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!-- Reuse existing EcoKoin logo asset; Build Action must be Resource. -->
            <Image Source="/Assets/Images/logo.png"
                   Width="116"
                   Height="108"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>

            <TextBlock Text="EcoKoin"
                       Margin="0,18,0,0"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForestGreenBrush}"
                       TextAlignment="Center"/>

            <TextBlock Text="Small Steps, Big Impact"
                       Margin="0,4,0,0"
                       FontSize="16"
                       Foreground="{StaticResource ForestGreenBrush}"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- LOADING BAR -->
        <StackPanel Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <ProgressBar x:Name="LoadingProgress"
                 Width="180"
                 Height="5"
                 Minimum="0"
                 Maximum="100"
                 Value="0"
                 IsIndeterminate="False"
                 Foreground="{StaticResource ForestGreenBrush}"
                 Background="#D5E0DB"
                 BorderThickness="0"/>

            <TextBlock Text="Menyiapkan EcoKoin..."
               FontSize="14"
               Foreground="#668177"
               Margin="0,16,0,0"
               HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Window>