<Window x:Class="EcoKoin.WPF.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoKoin - Reset Kata Sandi"
        Width="1200" Height="720" MinWidth="920" MinHeight="610"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8F7" FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="AuthForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="AuthMuted" Color="#668177"/>
        <SolidColorBrush x:Key="AuthOutline" Color="#D5E0DB"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Tampilkan kata sandi"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E9F2F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#B4D4D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubmitButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C4C3E"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#416957"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#1E352B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D97746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*" MinWidth="340"/>
            <ColumnDefinition Width="61*" MinWidth="520"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT BRAND PANEL: existing EcoKoin image assets; no duplicate assets needed. -->
        <Border Grid.Column="0" Background="{StaticResource AuthForest}" ClipToBounds="True">
            <Grid Margin="40,30,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/Assets/Images/logo.png" Width="49" Height="46" Stretch="Uniform" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EcoKoin" Foreground="White" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Small Steps, Big Impact" Foreground="#E9F2F1" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Awal baru untuk&#x0a;langkah baikmu."
                               FontFamily="{StaticResource HeadingFont}" FontSize="29" FontWeight="SemiBold"
                               LineHeight="37" Foreground="White"/>
                    <TextBlock Text="Atur ulang kata sandi, lalu kembali lanjutkan kebiasaan hemat energi bersama EcoPet."
                               TextWrapping="Wrap" Margin="0,12,0,16" Foreground="#E9F2F1" FontSize="14" LineHeight="21"/>
                    <Grid Height="242" MaxWidth="330" HorizontalAlignment="Stretch">
                        <Ellipse Fill="#395C4E" Margin="0,8,0,8"/>
                        <Image Source="/Assets/Images/happy.png" Width="204" Height="232"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Teman kecil untuk kebiasaan baikmu."
                               HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13" Foreground="#E9F2F1"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="❧  Hemat energi, mulai dari PC sendiri."
                           FontSize="12" Foreground="#E9F2F1"/>
            </Grid>
        </Border>

        <!-- RESET PANEL -->
        <Grid Grid.Column="1" Margin="32,12" ClipToBounds="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <Border Width="56" Height="56" Background="#E9F2F1" CornerRadius="16" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                               Foreground="{StaticResource AuthForest}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="PEMULIHAN AKUN" FontSize="11" Foreground="{StaticResource AuthMuted}" Margin="0,22,0,6"/>
                <TextBlock Text="Buat kata sandi baru" FontFamily="{StaticResource HeadingFont}" FontSize="30"
                           FontWeight="SemiBold" Foreground="{StaticResource AuthForest}"/>
                <TextBlock Text="Gunakan kata sandi baru untuk masuk ke akun EcoKoin kamu."
                           FontSize="14" Foreground="{StaticResource AuthMuted}" TextWrapping="Wrap" Margin="0,12,0,20"/>
                <TextBlock Text="Kata sandi baru" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <Border Height="52" Background="White" BorderBrush="{StaticResource AuthOutline}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="NewPassword" Grid.Column="0" Style="{StaticResource FieldPasswordBox}"
                                     VerticalAlignment="Center" PasswordChanged="NewPassword_Changed" MaxLength="128"
                                     AutomationProperties.Name="Kata sandi baru"/>
                        <TextBox x:Name="NewVisible" Grid.Column="0" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="13" Foreground="{StaticResource AuthForest}"
                                 VerticalContentAlignment="Center" VerticalAlignment="Center"
                                 TextChanged="NewVisible_Changed" MaxLength="128"/>
                        <TextBlock x:Name="NewHint" Text="Masukkan kata sandi baru" Grid.Column="0"
                                   Foreground="{StaticResource AuthMuted}" FontSize="13"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button x:Name="NewEye" Grid.Column="1" Style="{StaticResource EyeButtonStyle}"
                                Click="NewEye_Click" AutomationProperties.Name="Tampilkan atau sembunyikan Kata sandi baru">
                            <TextBlock x:Name="NewEyeIcon" Text="&#xE890;" FontSize="18"
                                       FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="Minimal 8 karakter, gunakan huruf dan angka."
                           FontSize="12" Foreground="{StaticResource AuthMuted}" Margin="0,8,0,0"/>
                <TextBlock Text="Konfirmasi kata sandi baru" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                <Border Height="52" Background="White" BorderBrush="{StaticResource AuthOutline}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ConfirmPassword" Grid.Column="0" Style="{StaticResource FieldPasswordBox}"
                                     VerticalAlignment="Center" PasswordChanged="ConfirmPassword_Changed" MaxLength="128"
                                     AutomationProperties.Name="Konfirmasi kata sandi baru"/>
                        <TextBox x:Name="ConfirmVisible" Grid.Column="0" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="13" Foreground="{StaticResource AuthForest}"
                                 VerticalContentAlignment="Center" VerticalAlignment="Center"
                                 TextChanged="ConfirmVisible_Changed" MaxLength="128"/>
                        <TextBlock x:Name="ConfirmHint" Text="Ulangi kata sandi baru" Grid.Column="0"
                                   Foreground="{StaticResource AuthMuted}" FontSize="13"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button x:Name="ConfirmEye" Grid.Column="1" Style="{StaticResource EyeButtonStyle}"
                                Click="ConfirmEye_Click" AutomationProperties.Name="Tampilkan atau sembunyikan Konfirmasi kata sandi baru">
                            <TextBlock x:Name="ConfirmEyeIcon" Text="&#xE890;" FontSize="18"
                                       FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock x:Name="ValidationMessage" FontSize="12" TextWrapping="Wrap" Foreground="#B54738"
                           Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="Simpan kata sandi    ➜" Margin="0,24,0,0" IsDefault="True"
                        Style="{StaticResource SubmitButtonStyle}" Click="SavePassword_Click"/>
                <Button Content="←  Kembali ke Masuk" Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,18,0,0" Click="BackToLogin_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>