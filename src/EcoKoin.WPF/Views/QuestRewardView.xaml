<UserControl x:Class="EcoKoin.WPF.Views.QuestRewardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EcoKoin.WPF.Components"
             Background="{StaticResource CanvasBrush}"
             ClipToBounds="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="QuestMuted" Color="#678177"/>
        <SolidColorBrush x:Key="QuestLine" Color="#CCD9D5"/>
        <SolidColorBrush x:Key="QuestDark" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="QuestText" Color="#222826"/>

        <Style x:Key="QuestSectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource QuestMuted}"/>
        </Style>

        <Style x:Key="QuestCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MistyBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="QuestMissionRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="59"/>
            <Setter Property="Background" Value="{StaticResource OceanCyanBrush}"/>
        </Style>

        <!-- UI only: no click events or coin-balance changes. -->
        <Style x:Key="QuestClaimButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SunOrangeBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClaimButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClaimButtonBorder" Property="Background" Value="#C95F2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClaimButtonBorder" Property="Background" Value="#A94722"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ClaimButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="QuestScroll"
                  Margin="18,12,18,12"
                  Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="Auto" MinHeight="162"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Misi &amp; Reward"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="25" FontWeight="SemiBold"
                               Foreground="{StaticResource ForestGreenBrush}"/>
                    <TextBlock Text="Hemat energi, kumpulkan koin, dan bahagiakan EcoPet kamu."
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11" Foreground="{StaticResource QuestText}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <components:LocationBadge
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"/>
            </Grid>

            <!-- BALANCE + ECOPET -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="67*"/>
                </Grid.ColumnDefinitions>

                <!-- Total EcoKoin; display only -->
                <Border Grid.Column="0" Style="{StaticResource QuestCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TOTAL ECOKOIN" Style="{StaticResource QuestSectionTitle}"/>
                            <TextBlock Text="{StaticResource IconCoins}"
                               Style="{StaticResource EcoAccentIcon}"
                               FontSize="19"
                               HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalKoinDisplay}"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource ForestGreenBrush}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding KoinMingguanDisplay}"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11" Foreground="{StaticResource QuestText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Reuse user's existing happy.png (same EcoPet as the dashboard). -->
                <Border Grid.Column="2" Style="{StaticResource QuestCard}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/Assets/Images/happy.png"
                               Width="108" Height="137" Stretch="Uniform"
                               VerticalAlignment="Center"/>

                        <Grid Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                <TextBlock Text="ECOPET" Style="{StaticResource QuestSectionTitle}"/>
                                <TextBlock Text="Happy &amp; Healthy" HorizontalAlignment="Right"
                                           Foreground="{StaticResource QuestMuted}" FontSize="10"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Langkah kecilmu bikin aku tumbuh!"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource ForestGreenBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2"
                                       Text="Terus hemat energi secara konsisten untuk menjaga EcoPet tetap sehat."
                                       FontFamily="{StaticResource BodyFont}" FontSize="11"
                                       Foreground="{StaticResource QuestMuted}"
                                       TextWrapping="Wrap" Margin="0,4,0,6"/>
                            <StackPanel Grid.Row="3">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource IconLevel}"
                                                   Style="{StaticResource EcoAccentIcon}"
                                                   FontSize="12"
                                                   Margin="0,0,5,0"/>

                                        <TextBlock Text="Level 5"
                                                   Foreground="{StaticResource SunOrangeBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="350 / 500 XP" HorizontalAlignment="Right"
                                               FontSize="10" Foreground="{StaticResource QuestMuted}"/>
                                </Grid>
                                <ProgressBar Maximum="500" Value="350" Height="7"
                                             Margin="0,4,0,0" BorderThickness="0"
                                             Foreground="{StaticResource SunOrangeBrush}"
                                             Background="{StaticResource QuestLine}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- DAILY QUESTS: 3 rows. No exchange/redeem section. -->
            <Border Grid.Row="3" Style="{StaticResource QuestCard}" Padding="16,13"
                    VerticalAlignment="Top">
                <StackPanel>

                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="MISI HARIAN" Style="{StaticResource QuestSectionTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{StaticResource IconClock}" Style="{StaticResource EcoCardIcon}"/>
                            <TextBlock Text="Diperbarui setiap hari pukul 00.00"
                                       FontSize="10" Foreground="{StaticResource QuestMuted}"/>
                        </StackPanel>
                    </Grid>

                    <!-- PROGRESS -->
                    <Grid>
                        <TextBlock Text="{Binding MisiSelesaiDisplay}"
                                   FontSize="11" Foreground="{StaticResource QuestMuted}"/>
                        <TextBlock Text="{Binding MisiPersenDisplay}" FontSize="10"
                                   Foreground="{StaticResource SunOrangeBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding MisiProgress, Mode=OneWay}" Maximum="100" Height="7" Margin="0,5,0,9"
                                 Foreground="{StaticResource ForestGreenBrush}"
                                 Background="{StaticResource QuestLine}"
                                 BorderThickness="0"/>

                    <!-- MISSION 1 -->
                    <Border Style="{StaticResource QuestMissionRow}" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30"
                                    CornerRadius="15" Background="{StaticResource MistyBrush}">
                                <TextBlock Text="{StaticResource IconCheck}"
                                           Style="{StaticResource EcoCardIcon}"
                                           FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                                <TextBlock Text="Aktifkan sleep saat ditinggal"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource ForestGreenBrush}"/>
                                <TextBlock Text="Belum tersedia"
                                           FontSize="10" Foreground="{StaticResource QuestMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="+30 Koin" IsEnabled="False"
                                    Style="{StaticResource QuestClaimButton}"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- MISSION 2: in progress -->
                    <Border Style="{StaticResource QuestMissionRow}"
                            Background="{StaticResource MistyBrush}"
                            BorderBrush="{StaticResource QuestLine}" BorderThickness="1"
                            Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30"
                                    CornerRadius="15" Background="{StaticResource MistyBrush}">
                                <TextBlock Text="{StaticResource IconBattery}"
                                           Style="{StaticResource EcoCardIcon}"
                                           FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                                <TextBlock Text="Power saver selama 4 jam"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource ForestGreenBrush}"/>
                                <TextBlock Text="{Binding PowerSaverStatus}"
                                           FontSize="10" Foreground="{StaticResource QuestMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding PowerSaverReward}" Style="{StaticResource QuestClaimButton}"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanClaimPowerSaver}" Command="{Binding ClaimPowerSaverCommand}"/>
                        </Grid>
                    </Border>

                    <!-- MISSION 3 -->
                    <Border Style="{StaticResource QuestMissionRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30"
                                    CornerRadius="15" Background="{StaticResource MistyBrush}">
                                <TextBlock Text="{StaticResource IconWeather}"
                                           Style="{StaticResource EcoCardIcon}"
                                           FontSize="21"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                                <TextBlock Text="Terapkan 1 rekomendasi cuaca"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource ForestGreenBrush}"/>
                                <TextBlock Text="Belum tersedia"
                                           FontSize="10" Foreground="{StaticResource QuestMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="+15 Koin" IsEnabled="False"
                                    Style="{StaticResource QuestClaimButton}"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
