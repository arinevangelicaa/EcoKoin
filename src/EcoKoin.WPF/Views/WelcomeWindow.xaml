<Window x:Class="EcoKoin.WPF.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoKoin - Selamat Datang"
        Width="1200" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8F7" FontFamily="{StaticResource BodyFont}"
        KeyboardNavigation.TabNavigation="Continue">
    <Window.Resources>
        <SolidColorBrush x:Key="WelForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="WelMuted" Color="#668177"/>
        <SolidColorBrush x:Key="WelMisty" Color="#E9F2F1"/>
        <SolidColorBrush x:Key="WelLine" Color="#D5E0DB"/>
        <SolidColorBrush x:Key="WelOrange" Color="#D97746"/>
        <Style x:Key="WelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WelForest}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="WelCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WelMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WelCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F6F8F7"/>
            <Setter Property="Foreground" Value="{StaticResource WelForest}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WelLine}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="WelToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="26" Background="Transparent">
                            <Border x:Name="SwitchTrack" Background="#AABCB4" CornerRadius="13"/>
                            <Ellipse x:Name="SwitchThumb" Width="20" Height="20" Fill="White"
                                     Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2C4C3E"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#F1F7F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource WelForest}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBackground" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBackground" Property="Background" Value="#E9F2F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBackground" Property="Background" Value="#B4D4D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{StaticResource WelForest}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBackground" Background="{TemplateBinding Background}" CornerRadius="12" Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBackground" Property="Background" Value="#416957"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBackground" Property="Background" Value="#1E352B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Native Windows titlebar provides real minimize, maximize, close. -->
    <Grid Margin="44,14,44,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="77"/>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Top brand line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Images/logo.png" Width="49" Height="46" Stretch="Uniform" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EcoKoin" Style="{StaticResource WelTitle}" FontSize="23"/>
                    <TextBlock Text="Small Steps, Big Impact" Foreground="{StaticResource WelForest}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource WelOrange}" Width="7" Height="7" Margin="0,0,8,0"/>
                <TextBlock Text="Pengaturan awal" Foreground="{StaticResource WelForest}" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <Border BorderBrush="{StaticResource WelLine}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Welcome message -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Selamat datang di EcoKoin!" FontSize="28" Style="{StaticResource WelTitle}"/>
            <TextBlock Text="Yuk, siapkan langkah pertamamu. Pilih kebiasaan hemat energi yang nyaman untuk PC kamu."
                       Foreground="{StaticResource WelMuted}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Settings and EcoPet column -->
        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.76*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource WelMisty}" CornerRadius="22" Padding="20,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mulai dengan yang sederhana" Style="{StaticResource WelTitle}" FontSize="17"/>

                        <!-- Power saver -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="#F6F8F7" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconDevice}" Style="{StaticResource EcoIcon}" FontSize="17" Foreground="{StaticResource WelOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Mode hemat daya" FontSize="14" Style="{StaticResource WelTitle}"/>
                                <TextBlock Text="Gunakan profil hemat daya untuk aktivitas harian." Style="{StaticResource WelCaption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="PowerSaverToggle" Grid.Column="2" Style="{StaticResource WelToggle}" IsChecked="True"
                                          ToolTip="Aktifkan atau nonaktifkan mode hemat daya" Checked="PowerSaverToggle_Changed" Unchecked="PowerSaverToggle_Changed"/>
                        </Grid>
                        <Border Grid.Row="2" Background="{StaticResource WelLine}" Height="1"/>

                        <!-- Sleep delay -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="152"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="#F6F8F7" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconSleep}" Style="{StaticResource EcoIcon}" FontSize="17" Foreground="{StaticResource WelOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Sleep saat idle" FontSize="14" Style="{StaticResource WelTitle}"/>
                                <TextBlock Text="Istirahatkan PC saat tidak digunakan." Style="{StaticResource WelCaption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="SleepCombo" Grid.Column="2" Style="{StaticResource WelCombo}" SelectedIndex="1"
                                      ToolTip="Pilih durasi sebelum sleep">
                                <ComboBoxItem Content="2 menit"/>
                                <ComboBoxItem Content="5 menit"/>
                                <ComboBoxItem Content="10 menit"/>
                                <ComboBoxItem Content="15 menit"/>
                                <ComboBoxItem Content="Tidak pernah"/>
                            </ComboBox>
                        </Grid>
                        <Border Grid.Row="4" Background="{StaticResource WelLine}" Height="1"/>

                        <!-- Weather location change -->
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="#F6F8F7" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconPreference}" Style="{StaticResource EcoIcon}" FontSize="17" Foreground="{StaticResource WelOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Lokasi cuaca" FontSize="14" Style="{StaticResource WelTitle}"/>
                                <TextBlock Text="Untuk saran sesuai cuaca di sekitarmu." Style="{StaticResource WelCaption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="EditLocationButton" Content="Catur Tunggal  ✎" Height="38" Click="EditLocation_Click"
                                        Background="#F6F8F7" Foreground="{StaticResource WelForest}"
                                        BorderBrush="{StaticResource WelLine}" BorderThickness="1" Cursor="Hand"/>
                                <Grid x:Name="LocationEditor" Visibility="Collapsed" Background="{StaticResource WelMisty}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocationInput" MaxLength="80" Height="36" FontSize="12" Padding="6,6" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✓" Click="SaveLocation_Click" ToolTip="Simpan lokasi" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="×" Click="CancelLocation_Click" ToolTip="Batal mengubah lokasi" Cursor="Hand"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Note from design -->
                <Border Grid.Row="1" Background="{StaticResource WelMisty}" CornerRadius="15" Padding="16,12" VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconInfo}" Style="{StaticResource EcoIcon}" FontSize="17" Foreground="{StaticResource WelForest}" Margin="0,0,10,0"/>
                        <TextBlock Text="Cuaca hanya memberi rekomendasi. Kecerahan layar tidak diubah otomatis tanpa persetujuanmu."
                                   TextWrapping="Wrap" Foreground="{StaticResource WelForest}" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- EcoPet greeting -->
            <Border Grid.Column="2" Background="{StaticResource WelMisty}" CornerRadius="22" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Source="/Assets/Images/happy.png"
                           Width="130"
                           Height="130"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,12,0,8"/>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="Hai, aku EcoPet!" Style="{StaticResource WelTitle}" FontSize="22" TextAlignment="Center"/>
                        <TextBlock Text="Aku tumbuh sehat saat kamu konsisten hemat energi. Kita mulai dari langkah kecil, ya."
                                   FontSize="12" Foreground="{StaticResource WelMuted}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,10,0,0" MaxWidth="255"/>
                    </StackPanel>
                    <Border Grid.Row="2" Margin="0,16,0,0" Background="#F6F8F7" CornerRadius="20" Padding="13,7" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✿" Foreground="{StaticResource WelOrange}" Margin="0,0,6,0"/>
                            <TextBlock Text="Petualangan kita baru dimulai" FontSize="11" Foreground="{StaticResource WelForest}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterMessage" Text="Semua pilihan bisa diubah di Pengaturan."
                       Foreground="{StaticResource WelMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Atur nanti" Click="Skip_Click" Style="{StaticResource WelLinkButton}" Margin="0,0,14,0"/>
            <Button Grid.Column="2" Content="Mulai menggunakan EcoKoin  →" Click="Start_Click" Style="{StaticResource WelPrimaryButton}" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>