<Window x:Class="EcoKoin.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EcoKoin - Masuk"
        Width="1200" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8F7" FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="AuthForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="AuthMuted" Color="#668177"/>
        <SolidColorBrush x:Key="AuthOutline" Color="#D5E0DB"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Tampilkan kata sandi"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E9F2F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#B4D4D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubmitButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C4C3E"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#416957"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#1E352B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Foreground" Value="{StaticResource AuthForest}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D97746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*" MinWidth="340"/>
            <ColumnDefinition Width="61*" MinWidth="520"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT BRAND PANEL; the user's existing EcoKoin assets are reused. -->
        <Border Grid.Column="0" Background="{StaticResource AuthForest}" ClipToBounds="True">
            <Grid Margin="40,30,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Source="/Assets/Images/logo.png" Width="49" Height="46" Stretch="Uniform" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EcoKoin" Foreground="White" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Small Steps, Big Impact" Foreground="#E9F2F1" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Langkah kecil,&#x0a;dampak besar."
                               FontFamily="{StaticResource HeadingFont}" FontSize="29" FontWeight="SemiBold"
                               LineHeight="37" Foreground="White"/>
                    <TextBlock Text="Lanjutkan kebiasaan hemat energi bersama EcoPet. Setiap langkah baikmu berarti."
                               TextWrapping="Wrap" Margin="0,12,0,16" Foreground="#E9F2F1" FontSize="14" LineHeight="21"/>
                    <Grid Height="218" MaxWidth="310" HorizontalAlignment="Stretch">
                        <Ellipse Fill="#395C4E" Margin="0,8,0,8"/>
                        <Image Source="/Assets/Images/happy.png" Width="204" Height="210"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Teman kecil untuk kebiasaan baikmu."
                               HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13" Foreground="#E9F2F1"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="☘  Hemat energi, mulai dari PC sendiri."
                           FontSize="12" Foreground="#E9F2F1"/>
            </Grid>
        </Border>

        <!-- FORM LOGIN -->
        <Grid Grid.Column="1" Margin="32,12" ClipToBounds="True">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <StackPanel>
                    <TextBlock Text="SELAMAT DATANG KEMBALI" FontSize="11" Foreground="{StaticResource AuthMuted}"/>
                    <TextBlock Text="Masuk ke EcoKoin" Margin="0,7,0,4"
                               Foreground="{StaticResource AuthForest}" FontFamily="{StaticResource HeadingFont}"
                               FontWeight="SemiBold" FontSize="30"/>
                    <TextBlock Text="EcoPet siap menemani hari hemat energimu."
                               FontSize="14" Foreground="{StaticResource AuthMuted}" Margin="0,0,0,23"/>

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <Border Height="52" Background="White" BorderBrush="{StaticResource AuthOutline}"
                            BorderThickness="1" CornerRadius="12" Margin="0,0,0,18" Padding="4,0">
                        <Grid>
                            <TextBox x:Name="EmailInput" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="14" Padding="11,0" MaxLength="254"
                                     Foreground="{StaticResource AuthForest}" TextChanged="EmailInput_TextChanged"/>
                            <TextBlock x:Name="EmailHint" Text="nama@contoh.com" Margin="15,0,0,0"
                                       Foreground="{StaticResource AuthMuted}" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Kata sandi" Style="{StaticResource FieldLabel}"/>
                    <Border Height="52" Background="White" BorderBrush="{StaticResource AuthOutline}"
                            BorderThickness="1" CornerRadius="12" Padding="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <PasswordBox x:Name="PasswordInput" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource AuthForest}" FontSize="14"
                                             Padding="11,0" VerticalContentAlignment="Center"
                                             PasswordChanged="PasswordInput_PasswordChanged"/>
                                <TextBox x:Name="PasswordVisible" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource AuthForest}" FontSize="14"
                                         Padding="11,0" VerticalContentAlignment="Center"
                                         Visibility="Collapsed" TextChanged="PasswordVisible_TextChanged"/>
                                <TextBlock x:Name="PasswordHint" Text="Masukkan kata sandi" Margin="15,0,0,0"
                                           Foreground="{StaticResource AuthMuted}" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="TogglePassword" Grid.Column="1" Style="{StaticResource EyeButtonStyle}"
                                    Click="TogglePassword_Click" ToolTip="Tampilkan kata sandi" AutomationProperties.Name="Tampilkan atau sembunyikan kata sandi">
                                <TextBlock x:Name="PasswordEyeIcon" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,22">
                        <CheckBox x:Name="RememberMe" Content="Ingat saya" VerticalAlignment="Center"
                                  Foreground="{StaticResource AuthForest}" FontSize="14" Cursor="Hand"
                                  ToolTip="Mengingat alamat email saja selama aplikasi berjalan"/>
                        <Button Content="Lupa kata sandi?" Click="ForgotPassword_Click" HorizontalAlignment="Right"
                                Style="{StaticResource LinkButtonStyle}"/>
                    </Grid>

                    <TextBlock x:Name="ValidationMessage" FontSize="12" Foreground="#B54738"
                               TextWrapping="Wrap" Margin="0,0,0,9" Visibility="Collapsed"/>
                    <Button Style="{StaticResource SubmitButtonStyle}" Click="LoginButton_Click"
                            IsDefault="True" ToolTip="Masuk ke mode demo frontend (belum autentikasi backend)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Masuk" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE72A;" FontSize="18" FontFamily="Segoe MDL2 Assets"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Belum punya akun?" FontSize="14" Foreground="{StaticResource AuthMuted}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Daftar akun" Style="{StaticResource LinkButtonStyle}"
                                Click="OpenRegister_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Mode demo frontend: kata sandi belum diverifikasi server."
                               FontSize="11" Foreground="{StaticResource AuthMuted}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>