<UserControl x:Class="EcoKoin.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EcoKoin.WPF.Components"
             Background="{StaticResource CanvasBrush}"
             ClipToBounds="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SetForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="SetMuted" Color="#668176"/>
        <SolidColorBrush x:Key="SetOrange" Color="#D97746"/>
        <SolidColorBrush x:Key="SetMint" Color="#B4D4D1"/>
        <Style x:Key="SetHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SetForest}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SetCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SetMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SetPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MistyBrush}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style x:Key="SetCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SetForest}"/>
            <Setter Property="Background" Value="#F6F8F7"/>
            <Setter Property="BorderBrush" Value="#C4D5CF"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="26">
                            <Border x:Name="Track" Background="{StaticResource SetForest}" CornerRadius="13"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Track" Property="Background" Value="#B8C8C2"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetPrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SetOrange}"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C45F32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A84927"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetResetButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SetForest}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ResetBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResetBorder" Property="Background" Value="#DDEAE5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ResetBorder" Property="Background" Value="#C4D8CF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ResetBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Compact desktop: four settings panels, always visible without ScrollViewer -->
    <Grid Margin="18,12,18,12" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="1.03*"/>
            <RowDefinition Height="1.17*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pengaturan" Style="{StaticResource SetHeading}" FontSize="25"/>
                <TextBlock Text="Atur kebiasaan hemat energi yang nyaman untukmu."
                           FontFamily="{StaticResource BodyFont}" Foreground="#222826" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <components:LocationBadge
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"/>
        </Grid>

        <!-- Top row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ENERGY -->
            <Border Grid.Column="0" Style="{StaticResource SetPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconPower}" Style="{StaticResource EcoIcon}" FontSize="18" Foreground="{StaticResource SetOrange}" Margin="0,0,9,0"/>
                        <TextBlock Text="Hemat daya" Style="{StaticResource SetHeading}" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Kurangi energi terbuang saat bekerja atau meninggalkan PC."
                               Style="{StaticResource SetCaption}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="145"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Profil hemat daya" Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="Profil untuk penggunaan harian." Style="{StaticResource SetCaption}" Margin="0,3,5,0"/>
                        </StackPanel>
                        <ComboBox x:Name="PowerProfileBox" Grid.Column="1" Style="{StaticResource SetCombo}" SelectedIndex="1">
                            <ComboBoxItem Content="Seimbang"/>
                            <ComboBoxItem Content="Hemat daya"/>
                            <ComboBoxItem Content="Performa"/>
                        </ComboBox>
                    </Grid>
                    <Border Grid.Row="3" Background="#294C3E" Opacity="0.13"/>
                    <Grid Grid.Row="4" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="145"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sleep saat idle" Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="Saat PC tidak digunakan selama:" Style="{StaticResource SetCaption}" Margin="0,3,5,0"/>
                        </StackPanel>
                        <ComboBox x:Name="SleepTimeBox" Grid.Column="1" Style="{StaticResource SetCombo}" SelectedIndex="1">
                            <ComboBoxItem Content="2 menit"/>
                            <ComboBoxItem Content="5 menit"/>
                            <ComboBoxItem Content="10 menit"/>
                            <ComboBoxItem Content="15 menit"/>
                            <ComboBoxItem Content="Tidak pernah"/>
                        </ComboBox>
                    </Grid>
                    <Border Grid.Row="5" Background="{StaticResource SetMint}" CornerRadius="11" Padding="10,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource IconReport}" Style="{StaticResource EcoIcon}" FontSize="17" Foreground="{StaticResource SetForest}" Margin="0,0,9,0"/>
                            <TextBlock Text="Kebiasaan kecil membantu mengumpulkan EcoKoin."
                                       Style="{StaticResource SetCaption}" Foreground="{StaticResource SetForest}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- WEATHER -->
            <Border Grid.Column="2" Style="{StaticResource SetPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource IconPreference}" Style="{StaticResource EcoIcon}" Foreground="{StaticResource SetOrange}" FontSize="18" Margin="0,0,9,0"/>
                            <TextBlock Text="Adaptif cuaca" Style="{StaticResource SetHeading}" FontSize="15"/>
                        </StackPanel>
                        <ToggleButton x:Name="WeatherToggle" Grid.Column="1" Style="{StaticResource SetSwitch}" IsChecked="True"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Dapatkan saran hemat energi sesuai cuaca di lokasimu."
                               Style="{StaticResource SetCaption}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Lokasi cuaca"
                                   Style="{StaticResource SetHeading}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Width="14" Height="17"
                                  Stretch="Uniform"
                                  Fill="{StaticResource SetForest}"
                                  VerticalAlignment="Center"
                                  Data="M12,2 C8.13,2 5,5.13 5,9 C5,14.25 12,22 12,22 C12,22 19,14.25 19,9 C19,5.13 15.87,2 12,2 Z M12,12 A3,3 0 1 1 12,6 A3,3 0 1 1 12,12 Z"/>
                            <TextBlock x:Name="WeatherLocationText"
                                       Grid.Column="2"
                                       Text="Menunggu lokasi perangkat"
                                       Style="{StaticResource SetHeading}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="3" Background="{StaticResource SetMint}" CornerRadius="14" Padding="12,6" Height="64" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONTOH SAAT MENDUNG / GELAP" Style="{StaticResource SetCaption}" FontSize="10"/>
                            <TextBlock Text="Turunkan kecerahan ke 40%" Style="{StaticResource SetHeading}" FontSize="13" Margin="0,5,0,2"/>
                            <TextBlock Text="Hanya rekomendasi. Kecerahan layar tidak diubah otomatis."
                                       Style="{StaticResource SetCaption}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="4" Text="Rekomendasi berdasarkan data cuaca OpenWeatherMap."
                               Style="{StaticResource SetCaption}" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom row -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ECOPET -->
            <Border Grid.Column="0" Style="{StaticResource SetPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconReport}"
                                   Style="{StaticResource EcoIcon}"
                                   FontSize="17"
                                   Foreground="{StaticResource SetOrange}"
                                   Margin="0,0,9,0"/>
                        <TextBlock Text="EcoPet" Style="{StaticResource SetHeading}" FontSize="15"/>
                    </StackPanel>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/Images/happy.png" Width="72" Height="82" Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                            <TextBlock Text="Teman kecil, semangat besar." Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="Konsisten hemat energi agar EcoPet tetap sehat dan bahagia."
                                       Style="{StaticResource SetCaption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource SetForest}" Opacity="0.13"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tampilkan maskot desktop" Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="EcoPet menemanimu di desktop." Style="{StaticResource SetCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="PetDesktopToggle" Grid.Column="1" Style="{StaticResource SetSwitch}" IsChecked="True"/>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pengingat merawat EcoPet" Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="Ingatkan untuk rutin hemat energi." Style="{StaticResource SetCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="PetReminderToggle" Grid.Column="1" Style="{StaticResource SetSwitch}" IsChecked="True"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- NOTIFICATIONS -->
            <Border Grid.Column="2" Style="{StaticResource SetPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconNotification}" Style="{StaticResource EcoIcon}" Foreground="{StaticResource SetOrange}" FontSize="17" Margin="0,0,9,0"/>
                        <TextBlock Text="Notifikasi" Style="{StaticResource SetHeading}" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Tetap semangat menjalankan misi hemat energi." Style="{StaticResource SetCaption}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pengingat misi harian" Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="Ingatkan misi yang belum selesai." Style="{StaticResource SetCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="MissionReminderToggle" Grid.Column="1" Style="{StaticResource SetSwitch}" IsChecked="True"/>
                    </Grid>
                    <Border Grid.Row="3" Background="{StaticResource SetForest}" Opacity="0.13"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Reward siap diklaim" Style="{StaticResource SetHeading}" FontSize="12"/>
                            <TextBlock Text="Beri tahu saat EcoKoin bisa diklaim." Style="{StaticResource SetCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="ClaimReminderToggle" Grid.Column="1" Style="{StaticResource SetSwitch}" IsChecked="True"/>
                    </Grid>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconInfo}" Style="{StaticResource EcoIcon}" FontSize="13" Foreground="{StaticResource SetMuted}" Margin="0,0,7,0"/>
                        <TextBlock Text="Nonaktifkan kapan saja jika ingin lebih fokus." Style="{StaticResource SetCaption}" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER SAVE & RESET -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource SetForest}" Opacity="0.15"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" Text="Simpan untuk menerapkan preferensi barumu."
                           Style="{StaticResource SetCaption}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Reset ke default" Style="{StaticResource SetResetButton}"
                        Click="ResetButton_Click" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="✓  Simpan perubahan" Style="{StaticResource SetPrimaryButton}"
                        VerticalAlignment="Center" Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>