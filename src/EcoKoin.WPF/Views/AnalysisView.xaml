<UserControl x:Class="EcoKoin.WPF.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EcoKoin.WPF.Components"
             Background="{StaticResource CanvasBrush}"
             ClipToBounds="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AnalMuted" Color="#678177"/>
        <SolidColorBrush x:Key="AnalForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="AnalOrange" Color="#D97746"/>
        <Style x:Key="AnalHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AnalForest}"/>
        </Style>
        <Style x:Key="AnalSection" TargetType="TextBlock" BasedOn="{StaticResource AnalHeading}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource AnalMuted}"/>
        </Style>
        <Style x:Key="AnalSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource AnalMuted}"/>
        </Style>
        <Style x:Key="AnalGraphTitle" TargetType="TextBlock" BasedOn="{StaticResource AnalHeading}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="AnalCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MistyBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="AnalysisScroll"
                  Margin="18,12,18,12"
                  Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="Auto" MinHeight="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="178"/>
            </Grid.RowDefinitions>

            <!-- PAGE HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Analisis" Style="{StaticResource AnalHeading}" FontSize="25"/>
                    <TextBlock Text="Lihat dampak hemat energimu bagi bumi dan pengeluaran."
                       FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="#222826"
                       TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <components:LocationBadge
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"/>
            </Grid>

            <!-- PERIOD -->
            <Grid Grid.Row="1" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="PeriodComboBox"
                  Grid.Column="0"
                  Width="155"
                  Height="34"
                  SelectedIndex="0"
                  SelectionChanged="PeriodComboBox_SelectionChanged"
                  Background="{StaticResource MistyBrush}"
                  Foreground="{StaticResource AnalForest}"
                  BorderBrush="#C4D5CF"
                  BorderThickness="1"
                  FontFamily="{StaticResource HeadingFont}"
                  FontSize="12"
                  Padding="8,3"
                  VerticalContentAlignment="Center"
                  Cursor="Hand">

                    <ComboBoxItem Content="7 hari terakhir"/>
                    <ComboBoxItem Content="Bulan ini"/>
                    <ComboBoxItem Content="Tahun ini"/>
                </ComboBox>

                <TextBlock x:Name="PeriodDescription"
                   Grid.Column="1"
                   Text="7 hari terakhir"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Style="{StaticResource AnalSmall}"/>
            </Grid>

            <!-- THREE KPI CARDS -->
            <UniformGrid x:Name="WeeklyKpiCards"
                 Grid.Row="2"
                 Columns="3"
                 MinHeight="113"
                 Margin="0,0,0,12">
                <Border Style="{StaticResource AnalCard}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Energi dihemat" Grid.Row="0" Style="{StaticResource AnalSmall}" FontSize="12"/>
                        <TextBlock Text="{StaticResource IconPower}" Grid.Row="0" Style="{StaticResource EcoIcon}" FontSize="18" HorizontalAlignment="Right" Foreground="{StaticResource AnalOrange}"/>
                        <TextBlock Text="{Binding EnergySavedKwh, StringFormat={}{0:N2} kWh, ConverterCulture=id-ID}" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource AnalHeading}" FontSize="25"/>
                        <TextBlock Text="{Binding PeriodDescription, StringFormat='Akumulasi energi · {0}'}" Grid.Row="2" Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource AnalCard}" Margin="8,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CO2 dihindari" Grid.Row="0" Style="{StaticResource AnalSmall}" FontSize="12"/>
                        <TextBlock Text="{StaticResource IconReport}" Grid.Row="0" Style="{StaticResource EcoIcon}" FontSize="18" HorizontalAlignment="Right" Foreground="{StaticResource AnalOrange}"/>
                        <TextBlock Text="{Binding Co2SavedKg, StringFormat={}{0:N2} kg, ConverterCulture=id-ID}" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource AnalHeading}" FontSize="25"/>
                        <TextBlock Text="Estimasi penurunan emisi" Grid.Row="2" Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource AnalCard}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0"
                                 Width="22" Height="22"
                                 HorizontalAlignment="Right">
                            <Grid Width="24" Height="24">
                                <Path Stroke="{StaticResource AnalOrange}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M3,6 L21,6 L21,18 L3,18 Z
                                            M12,9 A3,3 0 1 1 12,15
                                            A3,3 0 1 1 12,9
                                            M6,12 L6.01,12
                                            M18,12 L18.01,12"/>
                            </Grid>
                        </Viewbox>
                        <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MoneySavedRp, StringFormat=Rp{0:N0}, ConverterCulture=id-ID}" Style="{StaticResource AnalHeading}" FontSize="25"/>
                        </Viewbox>
                        <TextBlock Text="Estimasi penghematan listrik" Grid.Row="2" Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- TREND CHARTS -->
            <Grid Grid.Row="3" Margin="0,0,0,12">

                <Border x:Name="UnavailablePeriodPanel"
                Style="{StaticResource AnalCard}"
                MinHeight="108"
                Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock Text="Data periode belum tersedia"
                           Style="{StaticResource AnalHeading}"
                           FontSize="18"
                           TextAlignment="Center"/>

                        <TextBlock x:Name="UnavailablePeriodDescription"
                           Text="Data analisis periode ini belum tersedia."
                           Style="{StaticResource AnalSmall}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="WeeklyTrendChart"
                Style="{StaticResource AnalCard}"
                MinHeight="188"
                Padding="20,14,20,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DAMPAK PENGHEMATAN" Style="{StaticResource AnalSection}"/>
                        <TextBlock Grid.Row="1" Text="{Binding TrendNote}"
                       Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#2C4C3E" Margin="0,0,8,0"/>
                                        <TextBlock Text="CO2 dihindari" Style="{StaticResource AnalGraphTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Co2UnitLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AnalSmall}"/>
                                </Grid>
                                <Viewbox Grid.Row="1" MaxHeight="132" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Canvas x:Name="Co2ChartCanvas" Width="480" Height="200"/>
                                </Viewbox>
                            </Grid>
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#D97746" Margin="0,0,8,0"/>
                                        <TextBlock Text="Biaya dihemat" Style="{StaticResource AnalGraphTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MoneyUnitLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AnalSmall}"/>
                                </Grid>
                                <Viewbox Grid.Row="1" MaxHeight="132" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Canvas x:Name="MoneyChartCanvas" Width="480" Height="200"/>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SAVING SOURCES + INSIGHT -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AnalCard}" Margin="0,0,12,0" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SUMBER PENGHEMATAN" Style="{StaticResource AnalSection}"/>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Power saver -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="{StaticResource OceanCyanBrush}" CornerRadius="9" VerticalAlignment="Center">
                                    <TextBlock Text="{StaticResource IconBattery}" Style="{StaticResource EcoIcon}" FontSize="15" Foreground="{StaticResource AnalForest}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="Mode hemat daya" Foreground="{StaticResource AnalForest}" FontSize="12" FontFamily="{StaticResource BodyFont}"/>
                                    <TextBlock Text="Mengurangi penggunaan energi saat bekerja." Style="{StaticResource AnalSmall}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding PowerSaverSourceDisplay}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource AnalHeading}" FontSize="13"/>
                            </Grid>
                            <!-- Sleep -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="{StaticResource OceanCyanBrush}" CornerRadius="9" VerticalAlignment="Center">
                                    <TextBlock Text="{StaticResource IconSleep}" Style="{StaticResource EcoIcon}" FontSize="15" Foreground="{StaticResource AnalForest}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="Sleep saat ditinggal" Foreground="{StaticResource AnalForest}" FontSize="12" FontFamily="{StaticResource BodyFont}"/>
                                    <TextBlock Text="Mengurangi energi terbuang saat PC tidak digunakan." Style="{StaticResource AnalSmall}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SleepSourceDisplay}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource AnalHeading}" FontSize="13"/>
                            </Grid>
                            <!-- Weather-adaptive -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="{StaticResource OceanCyanBrush}" CornerRadius="9" VerticalAlignment="Center">
                                    <TextBlock Text="{StaticResource IconWeather}" Style="{StaticResource EcoIcon}" FontSize="15" Foreground="{StaticResource AnalOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="Kecerahan adaptif cuaca" Foreground="{StaticResource AnalForest}" FontSize="12" FontFamily="{StaticResource BodyFont}"/>
                                    <TextBlock Text="Menyesuaikan kecerahan layar dengan kondisi cuaca." Style="{StaticResource AnalSmall}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource AnalHeading}" FontSize="13"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AnalCard}" Margin="12,0,0,0" Padding="16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{StaticResource IconInsights}" Style="{StaticResource EcoIcon}" FontSize="16" Foreground="{StaticResource AnalOrange}" Margin="0,0,8,0"/>
                            <TextBlock Text="WAWASAN" Style="{StaticResource AnalSection}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InsightTitle}" Style="{StaticResource AnalHeading}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding InsightText}"
                         Style="{StaticResource AnalSmall}" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
