<UserControl x:Class="EcoKoin.WPF.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EcoKoin.WPF.Components"
             Background="{StaticResource CanvasBrush}"
             ClipToBounds="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AnalMuted" Color="#678177"/>
        <SolidColorBrush x:Key="AnalForest" Color="#2C4C3E"/>
        <SolidColorBrush x:Key="AnalOrange" Color="#D97746"/>
        <Style x:Key="AnalHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AnalForest}"/>
        </Style>
        <Style x:Key="AnalSection" TargetType="TextBlock" BasedOn="{StaticResource AnalHeading}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource AnalMuted}"/>
        </Style>
        <Style x:Key="AnalSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource AnalMuted}"/>
        </Style>
        <Style x:Key="AnalGraphTitle" TargetType="TextBlock" BasedOn="{StaticResource AnalHeading}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="AnalCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MistyBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>
    <!-- Layout compact desktop, 4 vertical sections. No ScrollViewer. -->
    <Grid Margin="18,12,18,12" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="125"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="178"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Analisis" Style="{StaticResource AnalHeading}" FontSize="25"/>
                <TextBlock Text="Lihat dampak hemat energimu bagi bumi dan pengeluaran."
                   FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="#222826"
                   TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <components:LocationBadge
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"/>
        </Grid>

        <!-- PERIOD -->
        <Grid Grid.Row="1" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="PeriodComboBox"
              Grid.Column="0"
              Width="155"
              Height="34"
              SelectedIndex="0"
              SelectionChanged="PeriodComboBox_SelectionChanged"
              Background="{StaticResource MistyBrush}"
              Foreground="{StaticResource AnalForest}"
              BorderBrush="#C4D5CF"
              BorderThickness="1"
              FontFamily="{StaticResource HeadingFont}"
              FontSize="12"
              Padding="8,3"
              VerticalContentAlignment="Center"
              Cursor="Hand">

                <ComboBoxItem Content="Minggu ini"/>
                <ComboBoxItem Content="Bulan ini"/>
                <ComboBoxItem Content="Tahun ini"/>
            </ComboBox>

            <TextBlock x:Name="PeriodDescription"
               Grid.Column="1"
               Text="7 hari terakhir · Senin–Minggu"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Style="{StaticResource AnalSmall}"/>
        </Grid>

        <!-- THREE KPI CARDS -->
        <UniformGrid x:Name="WeeklyKpiCards"
             Grid.Row="2"
             Columns="3"
             Margin="0,0,0,12">
            <Border Style="{StaticResource AnalCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Energi dihemat" Grid.Row="0" Style="{StaticResource AnalSmall}" FontSize="12"/>
                    <TextBlock Text="{StaticResource IconPower}" Grid.Row="0" Style="{StaticResource EcoIcon}" FontSize="18" HorizontalAlignment="Right" Foreground="{StaticResource AnalOrange}"/>
                    <TextBlock Text="2.5 kWh" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource AnalHeading}" FontSize="25"/>
                    <TextBlock Text="Akumulasi energi minggu ini" Grid.Row="2" Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource AnalCard}" Margin="8,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CO2 dihindari" Grid.Row="0" Style="{StaticResource AnalSmall}" FontSize="12"/>
                    <TextBlock Text="{StaticResource IconReport}" Grid.Row="0" Style="{StaticResource EcoIcon}" FontSize="18" HorizontalAlignment="Right" Foreground="{StaticResource AnalOrange}"/>
                    <TextBlock Text="1.2 kg" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource AnalHeading}" FontSize="25"/>
                    <TextBlock Text="Estimasi penurunan emisi" Grid.Row="2" Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource AnalCard}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0"
                             Width="22" Height="22"
                             HorizontalAlignment="Right">
                        <Grid Width="24" Height="24">
                            <Path Stroke="{StaticResource AnalOrange}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M3,6 L21,6 L21,18 L3,18 Z
                                        M12,9 A3,3 0 1 1 12,15
                                        A3,3 0 1 1 12,9
                                        M6,12 L6.01,12
                                        M18,12 L18.01,12"/>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="Rp12.500" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource AnalHeading}" FontSize="25"/>
                    <TextBlock Text="Estimasi penghematan listrik" Grid.Row="2" Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- TREND CHARTS -->
        <Grid Grid.Row="3" Margin="0,0,0,12">

            <Border x:Name="UnavailablePeriodPanel"
            Style="{StaticResource AnalCard}"
            Visibility="Collapsed">

                <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock Text="Data periode belum tersedia"
                       Style="{StaticResource AnalHeading}"
                       FontSize="18"
                       TextAlignment="Center"/>

                    <TextBlock x:Name="UnavailablePeriodDescription"
                       Text="Data analisis periode ini belum tersedia."
                       Style="{StaticResource AnalSmall}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="WeeklyTrendChart"
            Style="{StaticResource AnalCard}"
            Padding="20,14,20,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DAMPAK PENGHEMATAN MINGGUAN" Style="{StaticResource AnalSection}"/>
                    <TextBlock Grid.Row="1" Text="Estimasi dampak per hari, bukan akumulasi. Setiap grafik memakai skala dan satuan tersendiri."
                   Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#2C4C3E" Margin="0,0,8,0"/>
                                    <TextBlock Text="CO2 dihindari" Style="{StaticResource AnalGraphTitle}"/>
                                </StackPanel>
                                <TextBlock Text="kg CO2 / hari" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AnalSmall}"/>
                            </Grid>
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Canvas Width="480" Height="200">
                                    <Line X1="48" Y1="154.000" X2="453" Y2="154.000" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="146.0" Width="38" Height="18" Text="0" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Line X1="48" Y1="108.667" X2="453" Y2="108.667" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="100.66666666666666" Width="38" Height="18" Text="0.10" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Line X1="48" Y1="63.333" X2="453" Y2="63.333" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="55.333333333333314" Width="38" Height="18" Text="0.20" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Line X1="48" Y1="18.000" X2="453" Y2="18.000" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="10.0" Width="38" Height="18" Text="0.30" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Polyline Points="48.00,108.67 115.50,86.00 183.00,99.60 250.50,72.40 318.00,63.33 385.50,63.33 453.00,40.67" Stroke="#2C4C3E" StrokeThickness="2.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="45.3" Canvas.Top="105.97" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="18" Canvas.Top="82.66666666666666" Width="60" Height="16" Text="0.10" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="14" Canvas.Top="171" Width="68" Height="18" Text="Senin" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="112.8" Canvas.Top="83.30" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="85.5" Canvas.Top="60.0" Width="60" Height="16" Text="0.15" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="81.5" Canvas.Top="171" Width="68" Height="18" Text="Selasa" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="180.3" Canvas.Top="96.90" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="153" Canvas.Top="73.6" Width="60" Height="16" Text="0.12" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="149" Canvas.Top="171" Width="68" Height="18" Text="Rabu" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="247.8" Canvas.Top="69.70" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="220.5" Canvas.Top="46.39999999999999" Width="60" Height="16" Text="0.18" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="216.5" Canvas.Top="171" Width="68" Height="18" Text="Kamis" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="315.3" Canvas.Top="60.63" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="288" Canvas.Top="37.333333333333314" Width="60" Height="16" Text="0.20" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="284" Canvas.Top="171" Width="68" Height="18" Text="Jumat" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="382.8" Canvas.Top="60.63" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="355.5" Canvas.Top="37.333333333333314" Width="60" Height="16" Text="0.20" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="351.5" Canvas.Top="171" Width="68" Height="18" Text="Sabtu" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="450.3" Canvas.Top="37.97" Width="5.4" Height="5.4" Fill="#2C4C3E"/>
                                    <TextBlock Canvas.Left="423" Canvas.Top="14.666666666666657" Width="60" Height="16" Text="0.25" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#2C4C3E" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="419" Canvas.Top="171" Width="68" Height="18" Text="Minggu" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#D97746" Margin="0,0,8,0"/>
                                    <TextBlock Text="Biaya dihemat" Style="{StaticResource AnalGraphTitle}"/>
                                </StackPanel>
                                <TextBlock Text="Rupiah / hari" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AnalSmall}"/>
                            </Grid>
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Canvas Width="480" Height="200">
                                    <Line X1="48" Y1="154.000" X2="453" Y2="154.000" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="146.0" Width="38" Height="18" Text="0" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Line X1="48" Y1="108.667" X2="453" Y2="108.667" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="100.66666666666666" Width="38" Height="18" Text="1.000" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Line X1="48" Y1="63.333" X2="453" Y2="63.333" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="55.33333333333333" Width="38" Height="18" Text="2.000" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Line X1="48" Y1="18.000" X2="453" Y2="18.000" Stroke="#CFDBD8" StrokeThickness="1"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="10.0" Width="38" Height="18" Text="3.000" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Right"/>
                                    <Polyline Points="48.00,108.67 115.50,86.00 183.00,97.33 250.50,74.67 318.00,63.33 385.50,52.00 453.00,29.33" Stroke="#D97746" StrokeThickness="2.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="45.3" Canvas.Top="105.97" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="18" Canvas.Top="82.66666666666666" Width="60" Height="16" Text="1.000" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="14" Canvas.Top="171" Width="68" Height="18" Text="Senin" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="112.8" Canvas.Top="83.30" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="85.5" Canvas.Top="60.0" Width="60" Height="16" Text="1.500" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="81.5" Canvas.Top="171" Width="68" Height="18" Text="Selasa" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="180.3" Canvas.Top="94.63" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="153" Canvas.Top="71.33333333333334" Width="60" Height="16" Text="1.250" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="149" Canvas.Top="171" Width="68" Height="18" Text="Rabu" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="247.8" Canvas.Top="71.97" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="220.5" Canvas.Top="48.66666666666667" Width="60" Height="16" Text="1.750" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="216.5" Canvas.Top="171" Width="68" Height="18" Text="Kamis" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="315.3" Canvas.Top="60.63" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="288" Canvas.Top="37.33333333333333" Width="60" Height="16" Text="2.000" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="284" Canvas.Top="171" Width="68" Height="18" Text="Jumat" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="382.8" Canvas.Top="49.30" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="355.5" Canvas.Top="26.0" Width="60" Height="16" Text="2.250" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="351.5" Canvas.Top="171" Width="68" Height="18" Text="Sabtu" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                    <Ellipse Canvas.Left="450.3" Canvas.Top="26.63" Width="5.4" Height="5.4" Fill="#D97746"/>
                                    <TextBlock Canvas.Left="423" Canvas.Top="3.3333333333333286" Width="60" Height="16" Text="2.750" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#D97746" TextAlignment="Center"/>
                                    <TextBlock Canvas.Left="419" Canvas.Top="171" Width="68" Height="18" Text="Minggu" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="#678177" TextAlignment="Center"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- SAVING SOURCES + INSIGHT -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AnalCard}" Margin="0,0,12,0" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SUMBER PENGHEMATAN" Style="{StaticResource AnalSection}"/>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Power saver -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="{StaticResource OceanCyanBrush}" CornerRadius="9" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconBattery}" Style="{StaticResource EcoIcon}" FontSize="15" Foreground="{StaticResource AnalForest}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                <TextBlock Text="Mode hemat daya" Foreground="{StaticResource AnalForest}" FontSize="12" FontFamily="{StaticResource BodyFont}"/>
                                <TextBlock Text="Mengurangi penggunaan energi saat bekerja." Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="1.2 kWh" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource AnalHeading}" FontSize="13"/>
                        </Grid>
                        <!-- Sleep -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="{StaticResource OceanCyanBrush}" CornerRadius="9" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconSleep}" Style="{StaticResource EcoIcon}" FontSize="15" Foreground="{StaticResource AnalForest}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                <TextBlock Text="Sleep saat ditinggal" Foreground="{StaticResource AnalForest}" FontSize="12" FontFamily="{StaticResource BodyFont}"/>
                                <TextBlock Text="Mengurangi energi terbuang saat PC tidak digunakan." Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="0.8 kWh" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource AnalHeading}" FontSize="13"/>
                        </Grid>
                        <!-- Weather-adaptive -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="{StaticResource OceanCyanBrush}" CornerRadius="9" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource IconWeather}" Style="{StaticResource EcoIcon}" FontSize="15" Foreground="{StaticResource AnalOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                <TextBlock Text="Kecerahan adaptif cuaca" Foreground="{StaticResource AnalForest}" FontSize="12" FontFamily="{StaticResource BodyFont}"/>
                                <TextBlock Text="Menyesuaikan kecerahan layar dengan kondisi cuaca." Style="{StaticResource AnalSmall}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="0.5 kWh" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource AnalHeading}" FontSize="13"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AnalCard}" Margin="12,0,0,0" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{StaticResource IconInsights}" Style="{StaticResource EcoIcon}" FontSize="16" Foreground="{StaticResource AnalOrange}" Margin="0,0,8,0"/>
                        <TextBlock Text="WAWASAN MINGGU INI" Style="{StaticResource AnalSection}"/>
                    </StackPanel>
                    <TextBlock Text="Langkah kecil, dampak terkumpul." Style="{StaticResource AnalHeading}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Pada contoh ini, mode hemat daya menyumbang energi terbesar. Biasakan sleep saat meninggalkan PC untuk menghindari pemborosan saat idle."
                     Style="{StaticResource AnalSmall}" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>