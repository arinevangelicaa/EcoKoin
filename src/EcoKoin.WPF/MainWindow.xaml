<Window x:Class="EcoKoin.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:EcoKoin.WPF.Components"
        xmlns:views="clr-namespace:EcoKoin.WPF.Views"
        Title="EcoKoin - Dashboard"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <SolidColorBrush x:Key="Forest" Color="#2B4B3E"/>
        <SolidColorBrush x:Key="Muted" Color="#678177"/>
        <SolidColorBrush x:Key="Panel" Color="#E8F2F0"/>
        <SolidColorBrush x:Key="Mint" Color="#B5D6D3"/>
        <SolidColorBrush x:Key="Orange" Color="#E77942"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Forest}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Forest}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,3"/>
        </Style>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Orange}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#C95F2E"/>
                            </Trigger>

                            <Trigger Property="Button.IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#A94722"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E4EFEB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="17,14"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19*" MinWidth="180" MaxWidth="240"/>
            <ColumnDefinition Width="81*"/>
        </Grid.ColumnDefinitions>

        <!-- REUSABLE SIDEBAR -->
        <components:Sidebar x:Name="AppSidebar" Grid.Column="0" Loaded="AppSidebar_Loaded"/>

        <!-- DASHBOARD -->
        <ScrollViewer x:Name="DashboardContent"
                      Grid.Column="1"
                      Margin="18,12,18,12"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=DashboardContent}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="62"/>
                    <RowDefinition Height="Auto" MinHeight="110"/>
                    <RowDefinition Height="Auto" MinHeight="205"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock
                        Style="{StaticResource EcoIcon}"
                        Text="{StaticResource IconWeather}"
                        FontSize="30"
                        Foreground="{StaticResource SunOrangeBrush}"
                        Margin="0,0,15,0"
                        DockPanel.Dock="Left"/>
                        <StackPanel>
                            <TextBlock Text="{Binding GreetingDisplay}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Forest}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Pantau efisiensi energi, interaksi EcoPet, dan misi penghematan harian kamu" FontSize="10" Foreground="#303C38" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <components:LocationBadge x:Name="DashboardLocationBadge"
                        UseSavedLocation="False"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>
                </Grid>

                <!-- FOUR STAT CARDS -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                    <Border Background="{StaticResource Panel}" CornerRadius="24" Margin="0,0,8,0" Padding="12,10" >
                        <StackPanel>
                            <TextBlock Text="TOTAL ECOKOIN" Style="{StaticResource StatLabel}"/>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TotalKoinDisplay}" Style="{StaticResource StatValue}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding KoinMingguanDisplay}" FontSize="11" Foreground="#2D3834" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="24" Margin="8,0,8,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="CUACA HARI INI" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding SuhuDisplay}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="{Binding CuacaDisplay}" FontSize="11" Foreground="#2D3834" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="24" Margin="8,0,8,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="KELEMBAPAN UDARA" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding KelembapanDisplay}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="{Binding KondisiUdaraDisplay}" FontSize="11" Foreground="#2D3834" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="24" Margin="8,0,0,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="STATUS DAYA" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding BateraiDisplay}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="{Binding StatusDayaDisplay}" FontSize="11" Foreground="#2D3834" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- PET + RECOMMENDATIONS -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="24" Padding="14" Margin="0,0,12,0" >
                        <StackPanel>
                            <TextBlock Text="ECOPET" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding PetImageSource}" Width="112" Height="115" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" Margin="3,7,0,0">
                                    <TextBlock Text="{Binding PetMessageDisplay}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding PetStateDisplay}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                            Style="{StaticResource EcoAccentIcon}"
                                            Text="{StaticResource IconLevel}"
                                            FontSize="12"
                                            Margin="0,0,5,0"/>

                                            <TextBlock Text="{Binding LevelDisplay}"
                                           Foreground="{StaticResource Orange}"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding XpDisplay}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding XpProgress, Mode=OneWay}" Maximum="100" Height="9" Margin="0,3,0,0" Foreground="{StaticResource Orange}" Background="#C6D5D0" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="24" Padding="14" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="REKOMENDASI HEMAT ENERGI" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
                            <Border x:Name="WeatherRecommendationPanel"
                                    Background="{StaticResource Mint}" CornerRadius="19" Padding="9" Margin="0,0,0,6"
                                    Visibility="{Binding WeatherRecommendationsEnabled, Converter={StaticResource BooleanToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RekomendasiCuacaDisplay}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AlasanRekomendasiCuacaDisplay}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,6,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Terapkan" Style="{StaticResource OrangeButton}" VerticalAlignment="Center"
                                            Visibility="{Binding CanApplyWeatherRecommendation, Converter={StaticResource BooleanToVisibility}}"
                                            Click="ApplyBrightness_Click"/>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource Mint}" CornerRadius="19" Padding="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RekomendasiSleepDisplay}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AlasanRekomendasiSleepDisplay}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,6,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Terapkan" Style="{StaticResource OrangeButton}" VerticalAlignment="Center"
                                            Visibility="{Binding CanApplySleepRecommendation, Converter={StaticResource BooleanToVisibility}}"
                                            Click="ApplySleep_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ANALYTICS + DAILY QUEST -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="24" Padding="14" Margin="0,0,12,0" >
                        <StackPanel>
                            <TextBlock Text="ANALISIS MINGGUAN" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding GrafikRentangDisplay}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock Text="7 hari terakhir" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <Border Background="{StaticResource Mint}" CornerRadius="19" Padding="7" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Energi dihemat" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding EnergiDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Mint}" CornerRadius="19" Padding="7" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="CO2 dihindari" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding EmisiDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Mint}" CornerRadius="19" Padding="7" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Biaya dihemat" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding BiayaDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Background="{StaticResource Mint}" CornerRadius="19" Padding="8,6">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Tren harian penghematan" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikStatusDisplay}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource Orange}"/>
                                    </Grid>
                                    <Viewbox Height="52" Stretch="Fill" Margin="0,3,0,0">
                                        <Canvas Width="410" Height="85">
                                            <Line X1="0" X2="410" Y1="24" Y2="24" Stroke="#9DBFBA" StrokeThickness="1"/>
                                            <Line X1="0" X2="410" Y1="48" Y2="48" Stroke="#9DBFBA" StrokeThickness="1"/>
                                            <Line X1="0" X2="410" Y1="72" Y2="72" Stroke="#9DBFBA" StrokeThickness="1"/>
                                            <Polyline Points="{Binding GrafikPoints}" Stroke="{StaticResource Orange}" StrokeThickness="2" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="6" Canvas.Top="{Binding GrafikDot0Top}" Width="8" Height="8" Fill="{StaticResource Orange}"/>
                                            <Ellipse Canvas.Left="71" Canvas.Top="{Binding GrafikDot1Top}" Width="8" Height="8" Fill="{StaticResource Orange}"/>
                                            <Ellipse Canvas.Left="136" Canvas.Top="{Binding GrafikDot2Top}" Width="8" Height="8" Fill="{StaticResource Orange}"/>
                                            <Ellipse Canvas.Left="201" Canvas.Top="{Binding GrafikDot3Top}" Width="8" Height="8" Fill="{StaticResource Orange}"/>
                                            <Ellipse Canvas.Left="266" Canvas.Top="{Binding GrafikDot4Top}" Width="8" Height="8" Fill="{StaticResource Orange}"/>
                                            <Ellipse Canvas.Left="331" Canvas.Top="{Binding GrafikDot5Top}" Width="8" Height="8" Fill="{StaticResource Orange}"/>
                                            <Ellipse Canvas.Left="396" Canvas.Top="{Binding GrafikDot6Top}" Width="10" Height="10" Fill="{StaticResource Forest}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <UniformGrid Columns="7" Margin="0,0,0,0">
                                        <TextBlock Text="{Binding GrafikLabel0}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikLabel1}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikLabel2}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikLabel3}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikLabel4}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikLabel5}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding GrafikLabel6}" FontSize="10" Foreground="{StaticResource Forest}" HorizontalAlignment="Right"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="AnalysisDetailLink" Text="Lihat Selengkapnya   ➜" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="24" Padding="14" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DAILY QUEST" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
                            <Grid>
                                <TextBlock Text="{Binding MisiSelesaiDisplay}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock Text="{Binding MisiPersenDisplay}" HorizontalAlignment="Right" Foreground="{StaticResource Orange}" FontSize="10"/>
                            </Grid>
                            <ProgressBar Value="{Binding MisiProgress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4,0,6" Foreground="{StaticResource Forest}" Background="#C5D4CF" BorderThickness="0"/>
                            <Border Background="{StaticResource Mint}" CornerRadius="18" Padding="8,6" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SleepQuestItem.Title}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SleepQuestItem.StatusText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding SleepQuestItem.RewardLabel}" Style="{StaticResource OrangeButton}" VerticalAlignment="Center"
                                            IsEnabled="{Binding SleepQuestItem.CanClaim}" Command="{Binding SleepQuestItem.ClaimCommand}"/>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource Mint}" CornerRadius="18" Padding="8,6" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PowerSaverTitle}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PowerSaverStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding PowerSaverReward}" Style="{StaticResource OrangeButton}"
                                            VerticalAlignment="Center" IsEnabled="{Binding CanClaimPowerSaver}"
                                            Command="{Binding ClaimPowerSaverCommand}"/>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource Mint}" CornerRadius="18" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WeatherQuestItem.Title}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding WeatherQuestItem.StatusText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding WeatherQuestItem.RewardLabel}" Style="{StaticResource OrangeButton}" VerticalAlignment="Center"
                                            IsEnabled="{Binding WeatherQuestItem.CanClaim}" Command="{Binding WeatherQuestItem.ClaimCommand}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="QuestDetailLink" Text="Lihat Selengkapnya   ➜" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
        <!-- MISI & REWARD: shares same reusable sidebar -->
        <views:QuestRewardView x:Name="QuestRewardContent"
                               Grid.Column="1"
                               Visibility="Collapsed"/>
        <!-- ANALISIS -->
        <views:AnalysisView x:Name="AnalysisContent"
                            Grid.Column="1"
                            Visibility="Collapsed"/>
        <!-- PENGATURAN: new page, same sidebar and compact layout -->
        <views:SettingsView x:Name="SettingsContent"
                            Grid.Column="1"
                            Visibility="Collapsed"/>
    </Grid>
</Window>
