<UserControl
    x:Class="EcoKoin.WPF.Components.LocationBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource MistyBrush}"
            CornerRadius="18"
            Padding="12,7">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Style="{StaticResource EcoIcon}"
                Text="{StaticResource IconLocation}"
                FontSize="15"
                Margin="0,0,7,0"/>

            <TextBlock x:Name="LocationText"
                FontFamily="{StaticResource HeadingFont}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource ForestGreenBrush}"
                VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>