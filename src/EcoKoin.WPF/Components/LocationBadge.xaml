<UserControl
    x:Class="EcoKoin.WPF.Components.LocationBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{StaticResource MistyBrush}"
        CornerRadius="18"
        Padding="12,7">

        <StackPanel Orientation="Horizontal">

            <Viewbox
                Width="18"
                Height="18"
                Margin="0,0,7,0"
                VerticalAlignment="Center">

                <Canvas Width="24" Height="24">

                    <Path
                        Data="M12,22 C12,22 4,14 4,9 A8,8 0 0 1 20,9 C20,14 12,22 12,22 Z"
                        Stroke="#294C3E"
                        StrokeThickness="2"
                        StrokeLineJoin="Round"
                        Fill="Transparent"/>

                    <Ellipse
                        Canvas.Left="9"
                        Canvas.Top="6"
                        Width="6"
                        Height="6"
                        Stroke="#294C3E"
                        StrokeThickness="2"
                        Fill="Transparent"/>

                </Canvas>
            </Viewbox>

            <TextBlock
                x:Name="LocationText"
                Text="Lokasi cuaca"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                MaxWidth="150"
                TextTrimming="CharacterEllipsis"
                FontFamily="{StaticResource HeadingFont}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource ForestGreenBrush}"
                VerticalAlignment="Center"/>

        </StackPanel>
    </Border>
</UserControl>
