<UserControl x:Class="EcoKoin.WPF.Components.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EcoKoin.WPF.Components"
             Width="240">
    <Border Background="{StaticResource ForestGreenBrush}">
        <Grid Margin="16,24,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Existing logo.png stays unchanged -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,36">
                <Image Source="/Assets/Images/logo.png" Width="49" Height="46" Stretch="Uniform" Margin="0,0,8,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EcoKoin" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Small Steps, Big Impact" FontFamily="{StaticResource BodyFont}" FontSize="10" Foreground="White"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SunOrangeBrush}">
                    <TextBlock x:Name="ProfileAvatarText" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                               FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MistyBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileNameText" Text="Hermione" FontFamily="{StaticResource HeadingFont}"
                               Foreground="{StaticResource MistyBrush}" FontWeight="SemiBold" FontSize="15"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ProfileEmailText" Text="hermione@mail.hogwarts.ac.id"
                               FontFamily="{StaticResource BodyFont}" FontSize="10"
                               Foreground="{StaticResource OceanCyanBrush}" Opacity="0.8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Same reusable menu controls as before -->
            <StackPanel Grid.Row="2">
                <components:SidebarMenuItem MenuText="Dashboard" IconGlyph="&#xE80F;" IsActive="True"/>
                <components:SidebarMenuItem MenuText="Misi &amp; Reward" IconGlyph="&#xE7C8;"/>
                <components:SidebarMenuItem MenuText="Analisis" IconGlyph="&#xE9D9;"/>
                <components:SidebarMenuItem MenuText="Pengaturan" IconGlyph="&#xE713;"/>
            </StackPanel>

            <!-- New bottom action: one button which changes between Logout and Login -->
            <Border Grid.Row="3" BorderBrush="#557163" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Button x:Name="AuthActionButton" Click="AuthActionButton_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="10,9">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shell" Property="Background" Value="#416555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AuthIconText" Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource OceanCyanBrush}" Width="22"/>
                        <TextBlock x:Name="AuthLabelText" Text="Logout" FontFamily="{StaticResource BodyFont}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>